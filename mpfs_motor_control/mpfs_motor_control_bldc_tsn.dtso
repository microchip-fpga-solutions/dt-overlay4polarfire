 *
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "microchip,mpfs-motor-control-kit","microchip,mpfs";
};

&{/} {
	#address-cells = <2>;
	#size-cells = <2>;

	ptpclk: ptp-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

	fpgaptp: uio@38040000 {
		compatible = "generic-uio";
		reg = <0x0 0x38040000 0x0 0x1000>;
		linux,uio-name = "mchp_pi";
		status = "okay";
	};

	tsnclk: tsn-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

	tsncfgclk: tsn-cfg-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};
};

&fabric_bus {
	#address-cells = <2>;
	#size-cells = <2>;

	core1588: ptp@40002000 {
		compatible = "microchip,core1588-rtl-v3";
		reg = <0x0 0x40002000 0x0 0x1000>;
		clocks = <&ptpclk>;
		clock-names = "tsu";
		status = "okay";
	};

	tse: ethernet@40001000 {
		compatible = "microchip,coretse-rtl-v3";
		reg = <0x0 0x40001000 0x0 0x1000>;
		pcdma-connected = <&pcdma>;
		#address-cells = <1>;
		#size-cells = <0>;
		local-mac-address = [00 04 a3 7a 0c 09];
		clocks = <&clkcfg 30>, <&clkcfg 27>;
		clock-names = "pclk", "pcdma";
		interrupt-parent = <&plic>;
		interrupts = <128>, <130>;
		interrupt-names = "mm2s_pcdma", "s2mm_pcdma";
		status = "okay";
		microchip,phy-null;
		microchip,core1588-ptp-handle = <&core1588>;

		phy-mode = "rgmii-txid";
		phy_3: ethernet-phy@3 {
			reg = <0x3>;
		};

		phy_4: ethernet-phy@4 {
			reg = <0x4>;
		};
	};

	pcdma: pcdma@60020000 {
		reg = <0x00 0x60020000 0x00 0x1000>;
	};

	tse_2: ethernet_port1@40003000 {
		compatible = "microchip,coretse-rtl-v3";
		reg = <0x0 0x40003000 0x0 0x1000>;
		pcdma-connected = <&pcdma1>;
		#address-cells = <1>;
		#size-cells = <0>;
		local-mac-address = [00 04 a3 7a 05 07];
		clocks = <&clkcfg 30>, <&clkcfg 27>;
		clock-names = "pclk", "pcdma";
		interrupt-parent = <&plic>;
		interrupts = <132>, <133>;
		interrupt-names = "mm2s_pcdma", "s2mm_pcdma";
		status = "okay";

		phy-mode = "rgmii-txid";
		phy-handle = <&phy_3>;
	};

	pcdma1: pcdma1@40004000 {
		reg = <0x00 0x40004000 0x00 0x1000>;
	};

	tse_3: ethernet_port2@40005000 {
		compatible = "microchip,coretse-rtl-v3";
		reg = <0x0 0x40005000 0x0 0x1000>;
		pcdma-connected = <&pcdma2>;
		#address-cells = <1>;
		#size-cells = <0>;
		local-mac-address = [00 04 a3 7a 05 08];
		clocks = <&clkcfg 30>, <&clkcfg 27>;
		clock-names = "pclk", "pcdma";
		interrupt-parent = <&plic>;
		interrupts = <131>, <134>;
		interrupt-names = "mm2s_pcdma", "s2mm_pcdma";
		status = "okay";

		phy-mode = "rgmii-txid";
		phy-handle = <&phy_4>;
	};

	pcdma2: pcdma2@40006000 {
		reg = <0x00 0x40006000 0x00 0x1000>;
	};

	tsn: tsn@40000000 {
		compatible = "microchip,coretsn-rtl-v3";
		reg = <0x0 0x40000000 0x0 0x1000>;
		clocks = <&tsncfgclk>, <&tsnclk>;
		clock-names = "apb", "core";
		status = "okay";
	};

	motor_adc: motor_adc@60000000 {
		compatible = "motor_adc";

		adc-scaling@60000000 {
			compatible = "microchip,adc-scaling-rtl-v4.3";
			reg = <0x0 0x60000000 0x0 0x1000>;
			status = "okay";
		};

		pwm3ph@60001000 {
			compatible = "microchip,pwm3ph-rtl-v4.2";
			reg = <0x0 0x60001000 0x0 0x1000>;
			status = "okay";
		};

		speed-id-iq-pi@60002000 {
			compatible = "microchip,speed-id-iq-pi-rtl-v4.2";
			reg = <0x0 0x60002000 0x0 0x1000>;
			status = "okay";
		};

		seq-controller@60003000 {
			compatible = "microchip,seq-controller-rtl-v4.2";
			reg = <0x0 0x60003000 0x0 0x1000>;
			status = "okay";
		};

		rate-limiter@60004000 {
			compatible = "microchip,rate-limiter-rtl-v4.2";
			reg = <0x0 0x60004000 0x0 0x1000>;
			status = "okay";
		};

		stepper-theta@60010000 {
			compatible = "microchip,stepper-theta-rtl-v4.2";
			reg = <0x0 0x60010000 0x0 0x1000>;
			status = "okay";
		};
	};
};
